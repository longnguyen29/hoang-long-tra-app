{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autonomous Codex Task v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "title", "type", "state", "risk", "summary", "acceptance_criteria", "allowed_paths", "max_files"],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,12}-[0-9]{8}-[0-9]{3,5}$"},
    "title": {"type": "string", "minLength": 5, "maxLength": 120},
    "type": {"enum": ["docs", "tests", "ui_polish", "accessibility", "bugfix_small"]},
    "state": {"enum": ["draft", "approved"]},
    "risk": {"const": "low"},
    "summary": {"type": "string", "minLength": 10, "maxLength": 4000},
    "acceptance_criteria": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "minLength": 4, "maxLength": 300}},
    "allowed_paths": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string"}},
    "max_files": {"type": "integer", "minimum": 1, "maximum": 30},
    "priority": {"type": "integer", "minimum": 1, "maximum": 5},
    "notes": {"type": "string", "maxLength": 1500}
  }
}
