-- Foundation only. This migration is not ready for production until the UI,
-- document archive and integration tests are complete.
begin;

alter table public.trade_opportunities add column if not exists is_b2b boolean not null default false;

-- Legal and banking information are entered privately by authorized managers.
create table public.b2b_selling_entities (
  id uuid primary key default gen_random_uuid(),
  name text not null check (length(trim(name)) between 1 and 200),
  details jsonb not null default '{}'::jsonb check (jsonb_typeof(details) = 'object'),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

-- Documents are versioned, not overwritten or deleted. The storage path points
-- to a private bucket; there are deliberately no public URLs or anonymous policies.
create table public.b2b_documents (
  id uuid primary key default gen_random_uuid(),
  opportunity_id text references public.trade_opportunities(id) on delete restrict,
  order_id text references public.orders(id) on delete restrict,
  selling_entity_id uuid references public.b2b_selling_entities(id) on delete restrict,
  kind text not null check (kind in ('framework','sales_contract','delivery_record','vat_invoice')),
  state text not null default 'draft' check (state in ('draft','complete','superseded')),
  valid_from date,
  valid_until date,
  invoice_number text,
  invoice_date date,
  storage_path text,
  draft jsonb not null default '{}'::jsonb check (jsonb_typeof(draft) = 'object'),
  created_by uuid not null default auth.uid() references auth.users(id),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  check ((kind = 'framework' and opportunity_id is not null and order_id is null)
      or (kind <> 'framework' and order_id is not null)),
  check (valid_until is null or (valid_from is not null and valid_until >= valid_from)),
  check (state <> 'complete' or nullif(trim(storage_path),'') is not null),
  check (state <> 'complete' or kind <> 'framework' or valid_from is not null),
  check (state <> 'complete' or kind <> 'vat_invoice'
      or (nullif(trim(invoice_number),'') is not null and invoice_date is not null))
);
create index b2b_documents_customer_idx on public.b2b_documents(opportunity_id,kind,created_at desc);
create index b2b_documents_order_idx on public.b2b_documents(order_id,kind,created_at desc);

alter table public.b2b_selling_entities enable row level security;
alter table public.b2b_documents enable row level security;
create policy "b2b entities manager read" on public.b2b_selling_entities for select to authenticated using (public.is_staff_manager());
create policy "b2b entities manager insert" on public.b2b_selling_entities for insert to authenticated with check (public.is_staff_manager());
create policy "b2b entities manager update" on public.b2b_selling_entities for update to authenticated using (public.is_staff_manager()) with check (public.is_staff_manager());
create policy "b2b documents manager read" on public.b2b_documents for select to authenticated using (public.is_staff_manager());
create policy "b2b documents manager insert" on public.b2b_documents for insert to authenticated with check (public.is_staff_manager() and created_by=auth.uid());
create policy "b2b documents manager update" on public.b2b_documents for update to authenticated using (public.is_staff_manager()) with check (public.is_staff_manager());
grant select,insert,update on public.b2b_selling_entities,public.b2b_documents to authenticated;

insert into storage.buckets(id,name,public,file_size_limit,allowed_mime_types)
values ('b2b-private-documents','b2b-private-documents',false,10485760,
  array['application/pdf','image/jpeg','image/png','application/vnd.openxmlformats-officedocument.wordprocessingml.document'])
on conflict (id) do nothing;

commit;
