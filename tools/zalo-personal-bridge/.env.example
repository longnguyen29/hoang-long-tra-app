# This file is local to your Mac. NEVER commit .env, Zalo cookies, tokens, or QR sessions.
CUSTOMER_MEMORY_INGEST_URL=https://www.hoanglongtra.com/api/webhooks/customer-memory/personal-zalo
CUSTOMER_MEMORY_BRIDGE_TOKEN=
# ONLY the Zalo user IDs you explicitly want to capture, separated by commas.
# Start with one non-critical contact. Never leave this blank to mean "all".
ALLOWED_ZALO_CHAT_IDS=
