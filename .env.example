# Supabase — Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (never commit, never expose to the browser). Needed by scripts/seed.mjs
# and by the /api/notify-order route, so set it in Vercel too, not just locally.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# New-order alerts to Telegram. Leave unset to disable — orders still work, they just
# won't ping. Token comes from @BotFather; chat id is the chat/group to post into.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shared PIN gating the internal ops console (ops.hoanglongtra.com and /ops). Unset means the
# console is unreachable — it fails closed, not open. Set in Vercel too, not just locally.
OPS_PIN=

# Viettel Post sends this exact secret back in webhook payloads. Generate a long random value,
# set it here and in Vercel, then enter the same value in Partner > Cấu hình webhook.
VIETTEL_POST_WEBHOOK_SECRET=

# Optional override. The app already carries Vietnam Post's published webhook verification key.
VIETNAM_POST_WEBHOOK_PUBLIC_KEY=

# Zalo ZBS Template Message delivery notices. Create a Zalo App, link it with the Hoàng
# Long OA and ZCA, grant "Gửi tin qua số điện thoại", then store the initial refresh token.
# Access tokens are refreshed automatically and never exposed to staff browsers.
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_ID=
ZALO_OA_REFRESH_TOKEN=
ZALO_ZBS_DELIVERED_PAID_TEMPLATE_ID=
ZALO_ZBS_DELIVERED_DUE_TEMPLATE_ID=
