# Supabase — Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (never commit, never expose to the browser). Needed by scripts/seed.mjs
# and by the /api/notify-order route, so set it in Vercel too, not just locally.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# New-order alerts to Telegram. Leave unset to disable — orders still work, they just
# won't ping. Token comes from @BotFather; chat id is the chat/group to post into.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
